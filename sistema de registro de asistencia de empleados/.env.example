DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=asistencia_db
JWT_SECRET=tu-clave-secreta-aqui-cambia-la
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4000

# En Railway no se necesita mapear DB_*: si faltan, el backend usa
# automaticamente las variables del plugin de MySQL (MYSQLHOST, MYSQLPORT,
# MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE) inyectadas por la plataforma.

# Frontend (carpeta client/): apuntar a la URL publica del backend en produccion
# NUXT_PUBLIC_API_BASE=https://tu-backend.up.railway.app/api/v1
